<table name="teilnehmer" layers="0" collapse-mode="1" max-obj-count="10" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<tag name="spieler_und_spielverwaltung"/>
	<position x="680" y="280"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
	</column>
	<column name="teilnehmertyp" not-null="true">
		<type name="varchar" length="0"/>
	</column>
	<column name="spielerrolle">
		<type name="varchar" length="0"/>
	</column>
	<column name="aktiv" not-null="true" default-value="TRUE">
		<type name="boolean" length="0"/>
	</column>
	<constraint name="teilnehmer_pk" type="pk-constr" table="public.teilnehmer">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_teilnehmer_teilnehmertyp" type="ck-constr" table="public.teilnehmer">
			<expression> <![CDATA[teilnehmertyp IN (
	'spieler',
	'bobby',
	'zuschauer'
)]]> </expression>
	</constraint>
	<constraint name="chk_teilnehmer_spielerrolle" type="ck-constr" table="public.teilnehmer">
			<expression> <![CDATA[spielerrolle IN (
	'mister_x',
	'detektiv'
)]]> </expression>
	</constraint>
	<constraint name="chk_teilnehmer_rollenkombinationen" type="ck-constr" table="public.teilnehmer">
			<expression> <![CDATA[(
	teilnehmertyp = 'spieler'
	AND id_benutzer IS NOT NULL
	AND (spielerrolle IS NULL OR spielerrolle IN ('mister_x', 'detektiv'))
)
OR
(
	teilnehmertyp = 'bobby'
	AND id_benutzer IS NULL
	AND spielerrolle IS NOT NULL
	AND spielerrolle = 'detektiv'
)
OR
(
	teilnehmertyp = 'zuschauer'
	AND id_benutzer IS NOT NULL
	AND spielerrolle IS NULL
)
]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_aktueller_knoten" index="3"/>
		<object name="id_benutzer" index="1"/>
		<object name="id_partie" index="2"/>
		<object name="id_startknoten" index="4"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="benutzer_fk" index="2"/>
		<object name="fk_teilnehmer_aktueller_knoten" index="3"/>
		<object name="fk_teilnehmer_startknoten" index="4"/>
		<object name="partie_fk" index="1"/>
	</customidxs></table>

<table name="karte" layers="0" collapse-mode="1" max-obj-count="6" z-value="0">
