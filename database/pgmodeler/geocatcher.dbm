	</column>
	<column name="hoehe" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<constraint name="karte_pk" type="pk-constr" table="public.karte">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="unq_karte_name_und_version" type="uq-constr" table="public.karte">
		<columns names="name,version" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_karte_version" type="ck-constr" table="public.karte">
			<expression> <![CDATA[version > 0]]> </expression>
	</constraint>
	<constraint name="chk_karte_breite_und_hoehe" type="ck-constr" table="public.karte">
			<expression> <![CDATA[breite > 0 AND hoehe > 0]]> </expression>
	</constraint>
</table>

<table name="knoten" layers="0" collapse-mode="1" max-obj-count="6" z-value="0">
