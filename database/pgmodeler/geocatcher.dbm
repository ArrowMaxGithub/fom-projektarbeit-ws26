		<type name="integer" length="0"/>
	</column>
	<constraint name="chk_ticketbestand_anzahl" type="ck-constr" table="public.ticketbestand">
			<expression> <![CDATA[anzahl >= 0]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_teilnehmer" index="0"/>
		<object name="id_ticketart" index="1"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="teilnehmer_fk" index="0"/>
		<object name="ticketart_fk" index="1"/>
		<object name="ticketbestand_pk" index="2"/>
	</customidxs></table>

