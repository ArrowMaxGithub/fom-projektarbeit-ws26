<table name="benutzer" layers="0" collapse-mode="1" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<tag name="spieler_und_spielverwaltung"/>
	<position x="0" y="420"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
	</column>
	<column name="benutzername" not-null="true">
		<type name="varchar" length="0"/>
	</column>
	<column name="erstellt_am" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="benutzer_pk" type="pk-constr" table="public.benutzer">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="unq_benutzer_benutzername" type="uq-constr" table="public.benutzer">
		<columns names="benutzername" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_benutzer_benutzername_leerzeichen" type="ck-constr" table="public.benutzer">
			<expression> <![CDATA[length(btrim(benutzername)) > 0]]> </expression>
	</constraint>
</table>

<table name="partie" layers="0" collapse-mode="1" max-obj-count="9" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<tag name="spieler_und_spielverwaltung"/>
	<position x="0" y="0"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="integer" length="0"/>
	</column>
	<column name="status" not-null="true" default-value="'lobby'">
		<type name="varchar" length="0"/>
	</column>
	<column name="aktuelle_runde" not-null="true" default-value="0">
		<type name="smallint" length="0"/>
	</column>
	<column name="aktuelle_phase" default-value="NULL">
		<type name="varchar" length="0"/>
	</column>
	<column name="gewinner" default-value="NULL">
		<type name="varchar" length="0"/>
	</column>
	<column name="ende_grund" default-value="NULL">
		<type name="varchar" length="0"/>
	</column>
	<constraint name="partie_pk" type="pk-constr" table="public.partie">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="chk_partie_status" type="ck-constr" table="public.partie">
			<expression> <![CDATA[status IN (
	'lobby',
	'laufend',
	'beendet',
	'abgebrochen'
)]]> </expression>
	</constraint>
	<constraint name="chk_partie_aktuelle_phase" type="ck-constr" table="public.partie">
			<expression> <![CDATA[aktuelle_phase IN (
	'mister_x',
	'detektive'
)]]> </expression>
	</constraint>
	<constraint name="chk_partie_gewinner" type="ck-constr" table="public.partie">
			<expression> <![CDATA[gewinner IN (
	'mister_x',
	'detektive'
)]]> </expression>
	</constraint>
	<constraint name="chk_partie_aktuelle_runde" type="ck-constr" table="public.partie">
			<expression> <![CDATA[aktuelle_runde BETWEEN 0 AND 22]]> </expression>
	</constraint>
	<constraint name="chk_partie_ende_grund" type="ck-constr" table="public.partie">
			<expression> <![CDATA[ ende_grund IN (
	'gefangen',
	'mr_x_blockiert',
	'mr_x_entkommen',
	'detektive_blockiert'
)]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="id_benutzer" index="1"/>
		<object name="id_karte" index="2"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="benutzer_fk" index="1"/>
		<object name="karte_fk" index="2"/>
	</customidxs></table>

