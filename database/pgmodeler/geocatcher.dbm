	<columns names="id_spielzug,id_ticketart" ref-type="src-columns"/>
</constraint>

<index name="unq_teilnehmer_nur_ein_mr_x_pro_partie" table="public.teilnehmer"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<column name="id_partie"/>
		</idxelement>
	<predicate> <![CDATA[spielerrolle = 'mister_x']]> </predicate>
</index>

<index name="unq_teilnehmer_detektiv_nicht_gleiche_position" table="public.teilnehmer"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<column name="id_partie"/>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="id_aktueller_knoten"/>
		</idxelement>
	<predicate> <![CDATA[spielerrolle = 'detektiv' AND id_aktueller_knoten IS NOT NULL]]> </predicate>
</index>

<index name="unq_verbindung_doppellungen_entfernen" table="public.verbindung"
	 concurrent="false" unique="true" fast-update="false" buffering="false" nulls-not-distinct="false"
	 index-type="btree" factor="0">
		<idxelement use-sorting="false">
			<expression> <![CDATA[LEAST(id_startknoten, id_zielknoten)]]> </expression>
		</idxelement>
		<idxelement use-sorting="false">
			<expression> <![CDATA[GREATEST(id_startknoten, id_zielknoten)]]> </expression>
		</idxelement>
		<idxelement use-sorting="false">
			<column name="id_verkehrsmittel"/>
		</idxelement>
</index>

